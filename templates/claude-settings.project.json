{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets.json)",
      "Read(./**/appsettings.*.local.json)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)"
    ]
  }
}
